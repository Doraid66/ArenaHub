# ArenaHub local configuration.
# Copy this file to .env and fill in your own LOCAL values:  cp .env.example .env
# Never commit .env, and never put real passwords here.

# --- PostgreSQL (used by docker-compose to create the database) ---
POSTGRES_USER=arenahub
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=arenahub
# POSTGRES_PORT=5432          # change if port 5432 is already used on your machine

# --- API ---
# For running the API on your Mac (outside Docker). Inside Docker, docker-compose
# replaces this with a URL that points to the "db" container.
DATABASE_URL=postgresql+psycopg://arenahub:change-me-local-db-password@localhost:5432/arenahub
LOG_LEVEL=INFO

# Login tokens: at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-local-secret

# Passwords for the seeded demo accounts (local test credentials only).
SEED_PLAYER_PASSWORD=change-me-player
SEED_MANAGER_PASSWORD=change-me-manager